{
  "extends": "@electron-toolkit/tsconfig/tsconfig.node.json",
  "include": [
    "electron.vite.config.*",
    "src/main/**/*",
    "src/preload/**/*",
    "src/shared/**/*",
    "plugins/**/test/ffiLoader.test.ts",
    "plugins/test/ffiLoaderHarness.ts",
    "scripts/**/*",
    "src/renderer/components/states/expand/pages/OverviewTab/hooks/useAgentQuotaSettings.ts",
    "src/renderer/components/states/expand/pages/OverviewTab/hooks/useOverviewClockSettings.ts",
    "src/renderer/components/states/expand/pages/OverviewTab/utils/overviewClockUtils.ts"
  ],
  "compilerOptions": {
    "composite": true,
    "noEmit": true,
    "moduleResolution": "bundler",
    "types": ["electron-vite/node"]
  }
}
